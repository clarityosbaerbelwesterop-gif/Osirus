DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_JWKS_URL=
UNOROUTER_BASE_URL=
UNOROUTER_API_KEY_1=
UNOROUTER_API_KEY_2=
UNOROUTER_API_KEY_3=
# M49: free-first (default) serves every role from the verified free-model
# pool discovered from /v1/models; "free" as a role value means the same.
OSIRUS_MODEL_POLICY=free-first
OSIRUS_MODEL_FAST=
OSIRUS_MODEL_STRONG=
OSIRUS_MODEL_THINKING=
OSIRUS_MODEL_CODING=
OSIRUS_MODEL_RESEARCH=
OSIRUS_MODEL_MATH=
OSIRUS_MODEL_VERIFY=
# AES-256-GCM key sealing connector/MCP/webhook credentials at rest; at
# least 32 characters. Without it every connection shows NOT_CONFIGURED.
OSIRUS_CONNECTOR_KEY=
# Optional free-pool preference hints written by the runtime sync from
# /v1/models; the runtime still discovers and verifies the pool itself.
OSIRUS_FREE_MODEL_PRIMARY=
OSIRUS_FREE_MODEL_SECONDARY=
OSIRUS_FREE_MODEL_TERTIARY=
# Rouge (M56) foundation core, and comma-separated substitute cores in
# order. Unset core means grok-4.6; substitutes override the measured list.
ROUGE_CORE_MODEL=
ROUGE_SUBSTITUTE_CORES=
# Grok 4.6 supports low, medium, high, and xhigh. Osirus defaults Grok 4.6 to high.
OSIRUS_REASONING_EFFORT=high
# Shared secret for the scheduler tick endpoint. At least 32 characters.
OSIRUS_SCHEDULER_SECRET=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to
# /api/scheduler/tick and cannot set a custom header; the configuration
# sync writes the same value here and in OSIRUS_SCHEDULER_SECRET.
CRON_SECRET=
# Enables the /ui-fixtures e2e surface. Never set in production (the flag
# is also hard-blocked when VERCEL_ENV=production).
OSIRUS_UI_FIXTURES=
# Tuning knobs read raw by the runtime; all optional.
# Seconds a request waits out a provider rate limit before failing (default 20).
OSIRUS_RATE_LIMIT_MAX_WAIT_SECONDS=
# Free-pool retries per request (default 4, capped at 8).
OSIRUS_FREE_MODEL_MAX_ATTEMPTS=
# Free-pool size cap (default unbounded, capped at 16).
OSIRUS_FREE_MODEL_POOL_SIZE=
# INTERNAL/DANGEROUS: "1" uncaps the Rouge "ultra" effort tier, the most
# expensive reasoning level. Leave unset until cost ceilings exist (M74/M75).
ROUGE_ALLOW_ULTRA=
# Optional deployment metadata supplied by Vercel; never set this to a secret.
VERCEL_GIT_COMMIT_SHA=
