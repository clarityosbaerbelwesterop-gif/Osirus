    "maxSeqLength": 4096,
    "microBatchSize": 1,
    "gradientAccumulation": 16,
    "warmupRatio": 0.03,
    "lrScheduler": "cosine",
    "gradientCheckpointing": true,
    "seed": 1337
  },
  "compute": {
    "provider": "runpod",
    "profileId": "a100-80gb",
    "gpuCount": 1,
    "maxRuntimeHours": 10
  },
  "evals": {
    "suites": [
      {
        "id": "humaneval",
        "harness": "lm-eval",
        "task": "humaneval",
        "metric": "pass_at_k,create_test",
        "limit": null,
        "unsafeCode": true
      },
      {
        "id": "mbpp",
        "harness": "lm-eval",
        "task": "mbpp",
        "metric": "pass_at_1,none",
