{
 "schema": "rouge.research-experiment/1",
 "id": "R1.17",
 "title": "Per-token adaptive depth (Mixture-of-Depths, 50% capacity)",
 "status": "pre-registered",
 "registered": "2026-09-29",
 "follows": "R1.02b (learned halting), R1.07/R1.08 (scorecard on benchmark v3)",
 "runner": "experiments/suite.py",
 "benchmarks": [
  "benchmarks/suite3.py",
  "benchmarks/audit.py"
 ],
 "question": "Does routing only half of the positions through each block (after the first) keep accuracy at fewer FLOPs, and beat a dense model with the same FLOPs?",
 "setup": {
  "batch": 64,
  "steps": 15000,
  "lr": 0.001,
  "weight_decay": 0.01,
  "warmup": 200,
  "eval_per_task": 200,
  "seeds": [
   1,
   2,
   3
  ],
  "hardware": "GitHub-hosted CPU runners (tier 0, $0)",
  "models": {
   "transformer": {
    "kind": "transformer",
    "d": 64,
    "layers": 4,
    "heads": 4
   },
   "transformer-d48": {
    "kind": "transformer",
    "d": 48,
    "layers": 4,
    "heads": 4
   },
   "mod50": {
    "kind": "mod",
    "d": 64,
    "layers": 4,
    "heads": 4,
    "capacity": 0.5
   }
  },
  "gate": {
   "checks": {
    "M1_acc": {
     "left": "mod50:dev.all",
     "op": ">=",
     "right": "transformer:dev.all",
     "plus": -0.02
    },
    "M1_flops": {
     "left": "mod50:flops",
     "op": "<=",
     "right": "transformer:flops",
     "times": 0.7
    },
    "M2_vs_flop_matched": {
     "left": "mod50:dev.all",
     "op": ">=",
     "right": "transformer-d48:dev.all",
     "plus": 0.02
    }
   },
   "decision": [
    {
     "result": "PASS",
     "all": [
      "M1_acc",
      "M1_flops",
      "M2_vs_flop_matched"
     ]
    },
    {
     "result": "PARTIAL",
     "all": [
      "M1_acc",
      "M1_flops"
     ]
    },
    {
     "result": "FAIL"
    }
   ]
  }
 },
 "compute": {
  "train_flops_per_run": 150000000000000.0
 },
 "predictions": {
  "untrained_flops": "transformer 22.8 M, mod50 14.3 M (0.63x), transformer-d48 12.8 M per example",
  "limitation": "routing sees the whole input (fine for answer-at-the-end tasks, not for generation)"
 },
 "prior_art": "Mixture-of-Depths 2404.02258, CALM 2207.07061",
 "not_claimed": "Mixture-of-Depths, recurrent-depth training and early exit are prior art; the question is whether they pay on this benchmark at this scale."
}
